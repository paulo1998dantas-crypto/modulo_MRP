# MRP I e II: leitura da base operacional compartilhada.
# Nunca publique chaves reais em Git ou no navegador.
SUPABASE_URL=
# Use apenas uma das duas opções abaixo. A primeira é a recomendada.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Segredo exclusivo do serviço MRP, com no mínimo 32 caracteres.
# É usado apenas para assinar a sessão HTTP dos perfis PCP e ADMIN.
MRP_SESSION_SECRET=

# Somente para teste local sem HTTPS. Não configure no Render.
# MRP_SESSION_COOKIE_SECURE=0
